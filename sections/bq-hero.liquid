{%- liquid
  assign product_name = section.settings.product_name_token | default: 'Il Nostro Dispositivo'
  assign cta_link = section.settings.cta_link | default: '#'
  assign accent = section.settings.accent_color | default: '#FF7E97'
-%}

<section
  class="bq-section bq-hero"
  data-bq-hero
  data-section-id="{{ section.id }}"
  style="--bq-accent: {{ accent }};"
  aria-label="{{ section.settings.headline_line_1 }}"
>
  <div class="bq-hero__inner">
  <div class="bq-hero__media">
    <div class="bq-hero__media-frame">
      {%- if section.settings.hero_video != blank -%}
        {%- assign vid = section.settings.hero_video -%}
        <video
          class="bq-hero__video"
          playsinline
          autoplay
          loop="loop"
          muted="muted"
          preload="metadata"
          width="100%"
          {% if vid.preview_image != blank %}poster="{{ vid.preview_image | image_url: width: 1080 }}"{% endif %}
        >
          {%- for vsource in vid.sources -%}
            <source src="{{ vsource.url }}" type="{{ vsource.mime_type }}">
          {%- endfor -%}
          {%- if vid.preview_image != blank -%}
            {{ vid.preview_image | image_url: width: 1080 | image_tag: class: 'bq-hero__video-fallback', widths: '600,900,1080', loading: 'lazy', alt: product_name }}
          {%- endif -%}
        </video>
      {%- elsif section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'bq-hero__image', widths: '600,900,1200', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'eager', alt: product_name }}
      {%- else -%}
        <div class="bq-hero__placeholder" aria-hidden="true">
          <span>Carica video o immagine hero (1:1)</span>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="bq-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bq-hero__eyebrow"><strong>{{ section.settings.eyebrow }}</strong></p>
    {%- endif -%}

    <h1 class="bq-hero__headline">
      {%- if section.settings.headline_line_1 != blank -%}{{ section.settings.headline_line_1 }}{%- endif -%}
      {%- if section.settings.headline_line_2_accent != blank %} <strong class="bq-hero__headline-accent">{{ section.settings.headline_line_2_accent }}</strong>{% endif -%}
    </h1>

    {%- if section.settings.intro != blank -%}
      <p class="bq-hero__intro">{{ section.settings.intro | replace: '%product%', product_name }}</p>
    {%- endif -%}

    <ul class="bq-hero__benefits" role="list">
      {%- for i in (1..3) -%}
        {%- assign key = 'benefit_' | append: i -%}
        {%- assign txt = section.settings[key] -%}
        {%- if txt != blank -%}
          <li class="bq-hero__benefit">
            <span class="bq-hero__benefit-dot" aria-hidden="true">
              <svg viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>{{ txt }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ cta_link }}" class="bq-hero__cta">{{ section.settings.cta_label }}</a>
    {%- endif -%}

    <div class="bq-hero__trust">
      {%- for i in (1..2) -%}
        {%- assign key = 'trust_' | append: i -%}
        {%- assign txt = section.settings[key] -%}
        {%- if txt != blank -%}
          <div class="bq-hero__trust-item">
            <span class="bq-check" aria-hidden="true">
              <svg viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>{{ txt }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign t_blocks = section.blocks | where: 'type', 'testimonial' -%}
    {%- assign t_size = t_blocks.size -%}
    {%- if t_size > 0 -%}
      <div class="bq-hero__testimonials" role="region" aria-roledescription="carousel" aria-label="Recensioni clienti">
        <ul class="bq-hero__testimonials-track" role="list">
          {%- if t_size > 1 -%}
            {%- assign tail_block = t_blocks | last -%}
            <li class="bq-hero__testimonial" data-clone="tail" aria-hidden="true">
              <figure class="bq-hero__testimonial-card">
                <div class="bq-hero__testimonial-top">
                  {%- if tail_block.settings.avatar != blank -%}
                    {{ tail_block.settings.avatar | image_url: width: 200 | image_tag: class: 'bq-hero__testimonial-avatar', widths: '80,160,200', loading: 'lazy', alt: tail_block.settings.name }}
                  {%- else -%}
                    <span class="bq-hero__testimonial-avatar bq-hero__testimonial-avatar--placeholder" aria-hidden="true">{{ tail_block.settings.name | slice: 0, 1 }}</span>
                  {%- endif -%}
                  <div class="bq-hero__testimonial-text">
                    <div class="bq-hero__testimonial-quote">
                      <p>{{ tail_block.settings.quote }}</p>
                    </div>
                  </div>
                </div>
                <div class="bq-hero__testimonial-bottom">
                  <div class="bq-hero__testimonial-author">
                    <h4>- {{ tail_block.settings.name }}</h4>
                    {%- if tail_block.settings.verified -%}
                      <span class="bq-hero__verified" aria-label="Verified">
                        <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="7" cy="7" r="7" fill="currentColor"/>
                          <path d="M3.5 7.2L6 9.5L10.5 4.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </div>
                  <div class="bq-hero__testimonial-stars" aria-label="{{ tail_block.settings.stars }} stelle su 5">
                    {%- for s in (1..5) -%}{%- if s <= tail_block.settings.stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
                  </div>
                </div>
              </figure>
            </li>
          {%- endif -%}
          {%- for block in t_blocks -%}
            <li class="bq-hero__testimonial" data-bq-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <figure class="bq-hero__testimonial-card">
                <div class="bq-hero__testimonial-top">
                  {%- if block.settings.avatar != blank -%}
                    {{ block.settings.avatar | image_url: width: 200 | image_tag: class: 'bq-hero__testimonial-avatar', widths: '80,160,200', loading: 'lazy', alt: block.settings.name }}
                  {%- else -%}
                    <span class="bq-hero__testimonial-avatar bq-hero__testimonial-avatar--placeholder" aria-hidden="true">{{ block.settings.name | slice: 0, 1 }}</span>
                  {%- endif -%}
                  <div class="bq-hero__testimonial-text">
                    <div class="bq-hero__testimonial-quote">
                      <p>{{ block.settings.quote }}</p>
                    </div>
                  </div>
                </div>
                <div class="bq-hero__testimonial-bottom">
                  <div class="bq-hero__testimonial-author">
                    <h4>- {{ block.settings.name }}</h4>
                    {%- if block.settings.verified -%}
                      <span class="bq-hero__verified" aria-label="Verified">
                        <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="7" cy="7" r="7" fill="currentColor"/>
                          <path d="M3.5 7.2L6 9.5L10.5 4.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </div>
                  <div class="bq-hero__testimonial-stars" aria-label="{{ block.settings.stars }} stelle su 5">
                    {%- for s in (1..5) -%}{%- if s <= block.settings.stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
                  </div>
                </div>
              </figure>
            </li>
          {%- endfor -%}
          {%- if t_size > 1 -%}
            {%- assign head_block = t_blocks | first -%}
            <li class="bq-hero__testimonial" data-clone="head" aria-hidden="true">
              <figure class="bq-hero__testimonial-card">
                <div class="bq-hero__testimonial-top">
                  {%- if head_block.settings.avatar != blank -%}
                    {{ head_block.settings.avatar | image_url: width: 200 | image_tag: class: 'bq-hero__testimonial-avatar', widths: '80,160,200', loading: 'lazy', alt: head_block.settings.name }}
                  {%- else -%}
                    <span class="bq-hero__testimonial-avatar bq-hero__testimonial-avatar--placeholder" aria-hidden="true">{{ head_block.settings.name | slice: 0, 1 }}</span>
                  {%- endif -%}
                  <div class="bq-hero__testimonial-text">
                    <div class="bq-hero__testimonial-quote">
                      <p>{{ head_block.settings.quote }}</p>
                    </div>
                  </div>
                </div>
                <div class="bq-hero__testimonial-bottom">
                  <div class="bq-hero__testimonial-author">
                    <h4>- {{ head_block.settings.name }}</h4>
                    {%- if head_block.settings.verified -%}
                      <span class="bq-hero__verified" aria-label="Verified">
                        <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="7" cy="7" r="7" fill="currentColor"/>
                          <path d="M3.5 7.2L6 9.5L10.5 4.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </div>
                  <div class="bq-hero__testimonial-stars" aria-label="{{ head_block.settings.stars }} stelle su 5">
                    {%- for s in (1..5) -%}{%- if s <= head_block.settings.stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
                  </div>
                </div>
              </figure>
            </li>
          {%- endif -%}
        </ul>
        <ol class="bq-hero__dots" role="tablist" aria-label="Slide selector">
          {%- for block in t_blocks -%}
            <li>
              <button
                type="button"
                class="bq-hero__dot{% if forloop.first %} is-active{% endif %}"
                data-bq-dot="{{ forloop.index0 }}"
                role="tab"
                aria-label="{{ forloop.index }} of {{ t_size }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              ></button>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}
  </div>
  </div>
</section>

{% stylesheet %}
  .bq-hero {
    background: var(--bq-body-bg);
    color: #000;
    font-family: var(--bq-font-sans);
  }

  .bq-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
    max-width: 1300px;
    margin-inline: auto;
    padding: 20px 16px;
  }

  .bq-hero__media { grid-column: 1; grid-row: 1; width: 100%; }
  .bq-hero__media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background: var(--bq-card-bg);
  }
  .bq-hero__video,
  .bq-hero__image,
  .bq-hero__video-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bq-hero__video-fallback { position: absolute; inset: 0; }
  .bq-hero__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bq-muted);
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  .bq-hero__content {
    grid-column: 1;
    grid-row: 2;
    padding-top: 30px;
    display: flex;
    flex-direction: column;
  }

  .bq-hero__eyebrow { margin: 0 0 11px; font-size: 16px; color: #000; font-weight: 700; }
  .bq-hero__eyebrow strong { font-weight: 700; }

  .bq-hero .bq-hero__headline {
    margin: 0 0 15px;
    font-size: 32px;
    line-height: 1.05;
    letter-spacing: 0;
    color: #000;
    font-weight: 500;
  }
  .bq-hero__headline-accent { color: var(--bq-accent); font-weight: 700; }

  .bq-hero__intro { margin: 0 0 21px; font-size: 16px; color: #000; line-height: 1.45; }

  .bq-hero__benefits { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .bq-hero__benefit { display: flex; gap: 8px; align-items: center; font-size: 16px; color: #000; line-height: 1.4; }
  .bq-hero__benefit-dot { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--bq-accent); color: #fff; }
  .bq-hero__benefit-dot svg { width: 14px; height: 14px; }

  .bq-hero__cta {
    display: block;
    width: 100%;
    margin: 0 0 22px;
    padding: 14px 24px;
    background: #000;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    transition: background 200ms ease;
  }
  .bq-hero__cta:hover { background: var(--bq-accent); }

  .bq-hero__trust { display: flex; flex-direction: row; flex-wrap: wrap; row-gap: 10px; column-gap: 12px; margin-bottom: 16px; }
  .bq-hero__trust-item { display: flex; gap: 10px; align-items: center; font-size: 14px; color: #000; }
  .bq-hero__trust-item .bq-check { width: 22px; height: 22px; }
  .bq-hero__trust-item .bq-check svg { width: 12px; height: 12px; }

  .bq-hero__testimonials { margin-top: 8px; max-width: 610px; }
  .bq-hero__testimonials-track {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-auto-flow: column; grid-auto-columns: 100%; gap: 0;
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
  }
  .bq-hero__testimonials-track::-webkit-scrollbar { display: none; }
  .bq-hero__testimonial { scroll-snap-align: center; min-width: 0; padding: 0 5px; }

  .bq-hero__testimonial-card {
    margin: 0; padding: 13px;
    background: #fff;
    border: 1px solid #000;
    border-radius: 16px;
    max-width: 610px;
  }
  .bq-hero__testimonial-top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .bq-hero__testimonial-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--bq-card-bg); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 28px; color: var(--bq-muted); text-transform: uppercase; }
  .bq-hero__testimonial-text { min-width: 0; }
  .bq-hero__testimonial-quote { font-style: italic; font-size: 14px; line-height: 1.6; color: #333; }
  .bq-hero__testimonial-quote p { margin: 0; font-size: 14px; }

  .bq-hero__testimonial-bottom { display: flex; align-items: center; justify-content: space-between; padding-left: 90px; }
  .bq-hero__testimonial-author { display: flex; align-items: center; gap: 5px; }
  .bq-hero__testimonial-author h4 { color: var(--bq-accent); font-size: 16px; font-weight: 600; margin: 0; }
  .bq-hero__verified { display: inline-flex; width: 14px; height: 14px; color: #1DA1F2; }
  .bq-hero__verified svg { width: 100%; height: 100%; }
  .bq-hero__testimonial-stars { color: var(--bq-accent); font-size: 16px; letter-spacing: 0; }

  .bq-hero__dots { list-style: none; margin: 16px 0 0; padding: 0; display: flex; gap: 6px; justify-content: center; }
  .bq-hero__dot {
    width: 10px; height: 10px; padding: 0; border: 0; border-radius: 50%;
    background: var(--bq-accent); opacity: 0.35;
    cursor: pointer; transition: opacity 200ms ease, transform 200ms ease, background 200ms ease;
  }
  .bq-hero__dot:hover { opacity: 0.6; }
  .bq-hero__dot.is-active { opacity: 1; background: #000; transform: scale(1.2); }

  @media (max-width: 600px) {
    .bq-hero__media-frame { overflow: visible; }
    .bq-hero__video,
    .bq-hero__image,
    .bq-hero__video-fallback { border-radius: 20px; }
  }

  @media (min-width: 768px) {
    .bq-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 1fr;
      column-gap: 70px;
      align-items: stretch;
      padding: 80px 40px;
    }
    .bq-hero__media { grid-column: 2; grid-row: 1; }
    .bq-hero__media-frame { aspect-ratio: auto; height: 100%; }

    .bq-hero__content {
      grid-column: 1;
      grid-row: 1;
      padding-top: 0;
      justify-content: center;
    }

    .bq-hero__eyebrow { font-size: 20px; }
    .bq-hero .bq-hero__headline { margin-bottom: 30px; font-size: 32px; }
    .bq-hero__intro { font-size: 20px; }
    .bq-hero__benefit { font-size: 20px; }
    .bq-hero__cta { width: max-content; padding: 16px 32px; font-size: 20px; }
    .bq-hero__trust { flex-direction: row; flex-wrap: nowrap; gap: 12px; }
    .bq-hero__trust-item { font-size: 18px; }
    .bq-hero__testimonial-card { padding: 15px; }
    .bq-hero__testimonial-top { gap: 18px; margin-bottom: 0; }
    .bq-hero__testimonial-bottom { padding-left: 98px; }
    .bq-hero__testimonial-stars { font-size: 18px; letter-spacing: 2px; }
  }

  @media (max-width: 390px) {
    .bq-hero .bq-hero__headline { font-size: 28px; }
    .bq-hero__cta { padding: 10px; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function init(root) {
      var track = root.querySelector('.bq-hero__testimonials-track');
      if (!track) return;
      var allSlides = Array.prototype.slice.call(track.querySelectorAll('.bq-hero__testimonial'));
      var realSlides = allSlides.filter(function (s) { return !s.hasAttribute('data-clone'); });
      var dots = root.querySelectorAll('.bq-hero__dot');
      if (!realSlides.length || !dots.length) return;

      var hasClones = allSlides.length > realSlides.length;

      function setActive(idx) {
        dots.forEach(function (d, i) {
          var on = i === idx;
          d.classList.toggle('is-active', on);
          d.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      }

      function scrollToSlide(target, smooth) {
        track.scrollTo({
          left: target.offsetLeft - track.offsetLeft,
          behavior: smooth ? 'smooth' : 'auto'
        });
      }

      if (hasClones) {
        requestAnimationFrame(function () {
          scrollToSlide(realSlides[0], false);
        });
      }

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          var target = realSlides[i];
          if (!target) return;
          scrollToSlide(target, true);
        });
      });

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.55) {
            var idx = realSlides.indexOf(entry.target);
            if (idx >= 0) setActive(idx);
          }
        });
      }, { root: track, threshold: [0.55, 0.75] });
      realSlides.forEach(function (s) { io.observe(s); });

      if (hasClones) {
        var wrapTimer;
        track.addEventListener('scroll', function () {
          clearTimeout(wrapTimer);
          wrapTimer = setTimeout(function () {
            var trackRect = track.getBoundingClientRect();
            var center = trackRect.left + trackRect.width / 2;
            for (var i = 0; i < allSlides.length; i++) {
              var s = allSlides[i];
              var sRect = s.getBoundingClientRect();
              if (center >= sRect.left && center <= sRect.right) {
                var clone = s.getAttribute('data-clone');
                if (clone === 'tail') {
                  scrollToSlide(realSlides[realSlides.length - 1], false);
                } else if (clone === 'head') {
                  scrollToSlide(realSlides[0], false);
                }
                break;
              }
            }
          }, 150);
        });
      }
    }

    document.querySelectorAll('[data-bq-hero]').forEach(init);
  })();
{% endjavascript %}

