{% comment %}
  CONSOLIDATED SECTION — Image-Text family
  Source family: .shopify-section.image-width-text-sec (10 instances in
  source/rendered.html, see inventories/family-audit-image-text.md).

  This file starts with the Section 3 (Under-eye causes) field set per
  inventories/section-03-causes.md. Schema grows by accretion as future
  sections in this family demand fields — DO NOT pre-add fields for
  hypothetical instances. Empty optional fields collapse via {% if %}
  guards, so adding fields later is non-breaking for existing instances.

  Discrepancy rulings applied (from inventory §9):
    - <img loading>: lazy (live runtime authoritative; below-fold)
    - <img sizes>: clean (min-width: 768px) 40vw, 100vw — do NOT mirror
      source's malformed (min-width: narrowpx) -100px hint
    - <img alt>: required, settable via image_alt schema
    - empty source .top-header div: omitted entirely (no h2 wrapper, no
      AOS fade target for an empty container)
    - <ol> markers stay UA-default decimal black; do NOT add ::marker color
    - no gradient, no decorative :after pseudo (Section 3 is solid bg only)
    - h3 strong: 700 weight + accent color (project-wide rule), NOT
      source's font-weight: normal

  AOS is loaded globally in layout/theme.liquid (decisions log 2026-04-26).
  Body-level data-attrs gate to easing=ease, duration=400, delay=0.

  Future field additions for this family (will accrue as sections demand):
    - heading (h2) for Sections 5, 13, 15-pt1, 15-pt3
    - body paragraph blocks (instead of single richtext) for narrative
      sections with mixed paragraph/list ordering
    - <ul> support (Sections 6, 8) — bullet vs checkmark style toggle
    - h5 sub-heading (Section 8 only)
    - video picker (Sections 4, 5)
    - CTA label + link (Sections 4, 5, 13)
    - dark-theme variant (Section 13: high-demand-selling-october)
    - decorative :after image (Sections 2, 4)
{% endcomment %}

{{ 'bq-image-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout | default: 'image_right'
  assign bg = section.settings.bg_color | default: '#F6F8F9'
  assign accent = section.settings.accent_color | default: '#FF7E97'
  assign pad_top = section.settings.section_padding_top | default: 10
  assign pad_bot = section.settings.section_padding_bottom | default: 10
  assign image_alt = section.settings.image_alt | default: 'Primo piano del contorno occhi con borse, occhiaie e linee sottili visibili'
  assign brand = section.settings.brand_name_token | default: 'Lumière Paris'
  assign product = section.settings.product_name_token | default: 'Il Nostro Dispositivo'
  assign heading = section.settings.heading_h2 | replace: '%brand%', brand | replace: '%product%', product
  assign subheading = section.settings.subheading_h3 | replace: '%brand%', brand | replace: '%product%', product
  assign intro = section.settings.intro_p | replace: '%brand%', brand | replace: '%product%', product
  assign list = section.settings.numbered_list | replace: '%brand%', brand | replace: '%product%', product
  assign closing = section.settings.closing_p | replace: '%brand%', brand | replace: '%product%', product
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
  assign feature_icon_blocks = section.blocks | where: 'type', 'feature_icon'
-%}

<section
  class="bq-image-text bq-image-text--{{ layout }}"
  data-section-id="{{ section.id }}"
  style="
    --bq-image-text-bg: {{ bg }};
    --bq-image-text-accent: {{ accent }};
    --bq-image-text-pad-top: {{ pad_top }}px;
    --bq-image-text-pad-bot: {{ pad_bot }}px;
  "
>
  <div class="bq-image-text__container">
    {%- if layout == 'video_centered' -%}

      {%- comment -%}§12 video_centered layout: heading → centered video → feature icons row{%- endcomment -%}
      <div class="bq-image-text__vc-wrap">
        {%- if subheading != blank -%}
          <h3 class="bq-image-text__subtitle bq-image-text__subtitle--center" data-aos="fade-up">{{ subheading }}</h3>
        {%- endif -%}

        <div class="bq-image-text__vc-video" data-aos="fade-up">
          {%- if section.settings.video != blank -%}
            {%- assign vid = section.settings.video -%}
            <video
              class="bq-image-text__vc-video-el"
              playsinline
              autoplay
              loop="loop"
              muted="muted"
              preload="metadata"
              {% if vid.preview_image != blank %}poster="{{ vid.preview_image | image_url: width: 1100 }}"{% endif %}
              aria-label="{{ image_alt | escape }}"
            >
              {%- for vsource in vid.sources -%}
                <source src="{{ vsource.url }}" type="{{ vsource.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif section.settings.image != blank -%}
            {{ section.settings.image
               | image_url: width: 1200
               | image_tag:
                   class: 'bq-image-text__vc-video-el',
                   widths: '400, 600, 900, 1200',
                   sizes: '(min-width: 768px) 800px, 100vw',
                   loading: 'lazy',
                   alt: image_alt
            }}
          {%- else -%}
            <div class="bq-image-text__vc-video-el bq-image-text__image--placeholder" aria-hidden="true">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        {%- if feature_icon_blocks.size > 0 -%}
          <div class="bq-image-text__feat-icons" data-aos="fade-up">
            {%- for block in feature_icon_blocks -%}
              {%- if block.settings.label != blank -%}
                <div class="bq-image-text__feat-icon" {{ block.shopify_attributes }}>
                  <span class="bq-feat-check" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                      <circle cx="7" cy="7" r="7" fill="#2ED215"/>
                      <path d="M10.8883 4.0835L5.54103 9.43072L3.11047 7.00016" stroke="white" stroke-width="0.833333" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <p>{{ block.settings.label }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

    {%- else -%}

      {%- comment -%}Standard side-by-side layouts: image_right / image_left{%- endcomment -%}
      {%- if heading != blank -%}
        <div class="bq-image-text__top-header" data-aos="fade-up">
          <h2 class="bq-image-text__h2">{{ heading }}</h2>
        </div>
      {%- endif -%}
      <div class="bq-image-text__row">
        <div class="bq-image-text__photo" data-aos="fade-up">
          {%- if section.settings.video != blank -%}
            {%- assign vid = section.settings.video -%}
            <video
              class="bq-image-text__video"
              playsinline
              autoplay
              loop="loop"
              muted="muted"
              preload="metadata"
              {% if vid.preview_image != blank %}poster="{{ vid.preview_image | image_url: width: 1100 }}"{% endif %}
              aria-label="{{ image_alt | escape }}"
            >
              {%- for vsource in vid.sources -%}
                <source src="{{ vsource.url }}" type="{{ vsource.mime_type }}">
              {%- endfor -%}
              {%- if vid.preview_image != blank -%}
                {{ vid.preview_image | image_url: width: 1100 | image_tag: class: 'bq-image-text__image', widths: '600,900,1100', loading: 'lazy', alt: image_alt }}
              {%- endif -%}
            </video>
          {%- elsif section.settings.image != blank -%}
            {{ section.settings.image
               | image_url: width: 1200
               | image_tag:
                   class: 'bq-image-text__image',
                   widths: '400, 600, 900, 1200',
                   sizes: '(min-width: 768px) 40vw, 100vw',
                   loading: 'lazy',
                   alt: image_alt
            }}
          {%- else -%}
            <div class="bq-image-text__image bq-image-text__image--placeholder" aria-hidden="true">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <div class="bq-image-text__content" data-aos="fade-up">
          {%- if subheading != blank -%}
            <h3 class="bq-image-text__subtitle">{{ subheading }}</h3>
          {%- endif -%}

          {%- if intro != blank -%}
            <div class="bq-image-text__intro">{{ intro }}</div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'paragraph' and block.settings.text != blank -%}
              <div class="bq-image-text__paragraph" {{ block.shopify_attributes }}>
                {{ block.settings.text | replace: '%brand%', brand | replace: '%product%', product }}
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if list != blank -%}
            <div class="bq-image-text__list">{{ list }}</div>
          {%- endif -%}

          {%- if closing != blank -%}
            <div class="bq-image-text__closing">{{ closing }}</div>
          {%- endif -%}

          {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
            <a class="bq-image-text__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}

          {%- if trust_blocks.size > 0 -%}
            <div class="bq-image-text__trust">
              {%- for block in trust_blocks -%}
                {%- if block.settings.label != blank -%}
                  <div class="bq-image-text__trust-item" {{ block.shopify_attributes }}>
                    <span class="bq-check" aria-hidden="true">
                      <svg viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <p>{{ block.settings.label }}</p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image + Text",
  "tag": "section",
  "class": "bq-section-image-text",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "brand_name_token",   "label": "Brand name (token)",   "default": "Lumière Paris",        "info": "Replaces the literal string %brand% wherever it appears in copy." },
    { "type": "text",     "id": "product_name_token", "label": "Product name (token)", "default": "Il Nostro Dispositivo", "info": "Replaces the literal string %product% wherever it appears in copy." },
    { "type": "richtext", "id": "heading_h2",   "label": "Heading (h2)", "info": "Optional section-level heading rendered above the row. Wrap accent words in <strong> for pink emphasis." },
    { "type": "richtext", "id": "subheading_h3", "label": "Subheading (h3)",     "default": "<p><strong>L'invecchiamento del contorno occhi</strong> non è una questione di genetica, disidratazione o poche ore di sonno.</p>", "info": "Wrap accent words in <strong> for pink emphasis." },
    { "type": "richtext", "id": "intro_p",       "label": "Intro paragraph",     "default": "<p>Dipende da tre fattori biologici che agiscono sotto la superficie della tua pelle.</p>" },
    { "type": "richtext", "id": "numbered_list", "label": "Numbered list",       "default": "<ol><li><strong>Microcircolazione rallentata</strong> fa ristagnare il sangue poco ossigenato e crea ombre scure.</li><li><strong>Drenaggio linfatico ridotto</strong> fa accumulare liquidi durante la notte e forma le borse.</li><li><strong>Perdita di collagene</strong> assottiglia ulteriormente la pelle già sottile, rendendo visibili capillari e ombre.</li></ol>", "info": "Use an <ol> for decimal-numbered items. Wrap each item's leading phrase in <strong>." },
    { "type": "richtext", "id": "closing_p",     "label": "Closing paragraph",   "default": "<p>Nessuna crema o siero topico può raggiungere queste cause in profondità. Ed è esattamente per questo che l'industria continua a vendertele.</p>" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url",  "id": "cta_link",  "label": "CTA link" },
    { "type": "header", "content": "Media" },
    { "type": "video",        "id": "video",     "label": "Video (1:1, autoplay/loop/muted)", "info": "Takes priority over image when both are set." },
    { "type": "image_picker", "id": "image",     "label": "Image (1:1, ~1200×1200)" },
    { "type": "text",         "id": "image_alt", "label": "Image / video alt text",      "default": "Primo piano del contorno occhi con borse, occhiaie e linee sottili visibili", "info": "Describe what the media shows for screen readers." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "layout", "label": "Image position", "default": "image_right",
      "options": [
        { "value": "image_right",    "label": "Image right, text left" },
        { "value": "image_left",     "label": "Image left, text right" },
        { "value": "video_centered", "label": "Video centered (§12 precision)" }
      ]
    },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color",     "label": "Background color",     "default": "#F6F8F9" },
    { "type": "color", "id": "accent_color", "label": "Accent color (strong)", "default": "#FF7E97" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "section_padding_top",    "label": "Section padding top",    "min": 0, "max": 200, "step": 5, "default": 10, "unit": "px" },
    { "type": "range", "id": "section_padding_bottom", "label": "Section padding bottom", "min": 0, "max": 200, "step": 5, "default": 10, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Paragraph text" }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" }
      ]
    },
    {
      "type": "feature_icon",
      "name": "Feature icon",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Short noun phrase (e.g. 'Diodi LED di grado medico')" }
      ]
    }
  ],
  "presets": [
    { "name": "Image + Text — Causes", "category": "Botanique" }
  ]
}
{% endschema %}
