{% comment %}
  Section 6 — Results timeline. Singleton.
  Source: source/rendered.html lines 5836–6620.

  HTML class names match source verbatim (no BEM): .echanced-scents-main,
  .enhanced-timeline, .timeline, .timeline-step, .card.left-card / .right-card,
  .left-card-item, .leftcard-grid, .right-text-box, .number, .custo-button,
  .custom-btn, .shipping-list. CSS likewise verbatim from source's inline
  <style> with three documented drops (see assets/bq-results.css header).

  Animation: vanilla JS adds .active / .exiting on each timeline-step based
  on viewport intersection; CSS transitions handle the visual.
  Pink fill line: scroll handler writes --timeline-progress on .timeline.
{% endcomment %}

{{ 'bq-results.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .echanced-scents-main {
    background-image: url({{ 'bq-results-bg.jpg' | asset_url }});
  }
</style>

{%- liquid
  assign brand = section.settings.brand_name_token | default: 'Lumière Paris'
  assign product = section.settings.product_name_token | default: 'Il Nostro Dispositivo'
  assign heading = section.settings.heading_h2 | replace: '%brand%', brand | replace: '%product%', product
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
-%}

<section class="echanced-scents-main" data-section-id="{{ section.id }}">
  <div class="enhanced-timeline page-width">
    {%- if heading != blank -%}
      <h2>{{ heading }}</h2>
    {%- endif -%}
    <h3></h3>{%- comment -%} Empty h3 mirrors source DOM (rendered.html:5840). Renders 0 height + 5px margin-bottom. {%- endcomment -%}

    {%- if step_blocks.size > 0 -%}
      <div class="timeline">
        {%- for block in step_blocks -%}
          {%- assign is_odd = forloop.index0 | modulo: 2 -%}
          {%- assign desc = block.settings.description | replace: '%brand%', brand | replace: '%product%', product | replace: '<p>', '' | replace: '</p>', '' -%}
          {%- case forloop.index -%}
            {%- when 1 -%}{%- assign step_icon_file = 'bq-results-icon-default.png' -%}
            {%- when 2 -%}{%- assign step_icon_file = 'bq-results-icon-2.png' -%}
            {%- when 3 -%}{%- assign step_icon_file = 'bq-results-icon-3.png' -%}
            {%- when 4 -%}{%- assign step_icon_file = 'bq-results-icon-4.png' -%}
            {%- when 5 -%}{%- assign step_icon_file = 'bq-results-icon-5.png' -%}
            {%- when 6 -%}{%- assign step_icon_file = 'bq-results-icon-4.png' -%}
            {%- else  -%}{%- assign step_icon_file = 'bq-results-icon-default.png' -%}
          {%- endcase -%}
          {%- if is_odd == 0 -%}
            {%- comment -%} Visual steps 1, 3, 5: heading-card LEFT, description-card RIGHT {%- endcomment -%}
            <div class="timeline-step exiting" {{ block.shopify_attributes }}>
              <div class="card left-card left-card-item leftcard-grid">
                {%- if block.settings.result_image != blank -%}
                  <img src="{{ block.settings.result_image | image_url: width: 400 }}" alt="" width="{{ block.settings.result_image.width }}" height="{{ block.settings.result_image.height }}" loading="lazy">
                {%- else -%}
                  <img src="{{ 'bq-results-step.png' | asset_url }}" alt="" width="70" height="70" loading="lazy">
                {%- endif -%}
                <h4><strong>{{ block.settings.time_label }}<br></strong>{{ block.settings.heading }}</h4>
              </div>
              <div class="number">
                <svg width="72" height="72" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="36" cy="36" r="35.5" fill="#FF7E97" stroke="#FF7E97"/>
                  <path d="M50 26L30.75 45.25L22 36.5" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="card right-card right-text-box">
                <p>
                  {%- comment -%} Defensive: image_picker may return truthy placeholder objects without a real image; require .id (only real Shopify images have one). {%- endcomment -%}
                  {%- if block.settings.desc_icon != blank and block.settings.desc_icon.id -%}
                    <img src="{{ block.settings.desc_icon | image_url: width: 200 }}" alt="" width="{{ block.settings.desc_icon.width }}" height="{{ block.settings.desc_icon.height }}" loading="lazy">
                  {%- else -%}
                    <img src="{{ step_icon_file | asset_url }}" alt="" width="40" height="40" loading="lazy">
                  {%- endif -%}
                  {{ desc }}
                </p>
              </div>
            </div>
          {%- else -%}
            {%- comment -%} Visual steps 2, 4, 6: description-card LEFT, heading-card RIGHT {%- endcomment -%}
            <div class="timeline-step exiting" {{ block.shopify_attributes }}>
              <div class="card left-card right-text-box">
                <p>
                  {%- comment -%} Defensive: image_picker may return truthy placeholder objects without a real image; require .id (only real Shopify images have one). {%- endcomment -%}
                  {%- if block.settings.desc_icon != blank and block.settings.desc_icon.id -%}
                    <img src="{{ block.settings.desc_icon | image_url: width: 200 }}" alt="" width="{{ block.settings.desc_icon.width }}" height="{{ block.settings.desc_icon.height }}" loading="lazy">
                  {%- else -%}
                    <img src="{{ step_icon_file | asset_url }}" alt="" width="40" height="40" loading="lazy">
                  {%- endif -%}
                  {{ desc }}
                </p>
              </div>
              <div class="number">
                <svg width="72" height="72" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="36" cy="36" r="35.5" fill="#FF7E97" stroke="#FF7E97"/>
                  <path d="M50 26L30.75 45.25L22 36.5" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="card right-card">
                <h4><strong>{{ block.settings.time_label }}<br></strong>{{ block.settings.heading }}</h4>
                {%- if block.settings.result_image != blank -%}
                  <img src="{{ block.settings.result_image | image_url: width: 400 }}" alt="" width="{{ block.settings.result_image.width }}" height="{{ block.settings.result_image.height }}" loading="lazy">
                {%- else -%}
                  <img src="{{ 'bq-results-step.png' | asset_url }}" alt="" width="70" height="70" loading="lazy">
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign has_cta = false -%}
    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}{%- assign has_cta = true -%}{%- endif -%}
    {%- if has_cta or trust_blocks.size > 0 -%}
      <div class="custo-button">
        {%- if has_cta -%}
          <a class="custom-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if trust_blocks.size > 0 -%}
          <ul class="shipping-list" role="list">
            {%- for block in trust_blocks -%}
              {%- if block.settings.label != blank -%}
                <li {{ block.shopify_attributes }}>
                  <svg width="17" height="17" viewBox="0 0 17 17" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="8.5" cy="8.5" r="7.5" fill="#fff"/>
                    <path d="M8.33333 0C3.75 0 0 3.75 0 8.33333C0 12.9167 3.75 16.6667 8.33333 16.6667C12.9167 16.6667 16.6667 12.9167 16.6667 8.33333C16.6667 3.75 12.9167 0 8.33333 0ZM6.66667 12.5L2.5 8.33333L3.675 7.15833L6.66667 10.1417L12.9917 3.81667L14.1667 5L6.66667 12.5Z" fill="#00AD21"/>
                  </svg>
                  {{ block.settings.label }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var timeline = section.querySelector('.timeline');
    var steps = section.querySelectorAll('.timeline-step');
    if (!timeline || !steps.length) return;

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          entry.target.classList.remove('exiting');
        } else if (entry.target.classList.contains('active')) {
          entry.target.classList.remove('active');
          entry.target.classList.add('exiting');
        }
      });
    }, { rootMargin: '-100px 0px -30% 0px', threshold: 0 });
    steps.forEach(function (s) { io.observe(s); });

    function updateProgress() {
      var rect = timeline.getBoundingClientRect();
      if (rect.height <= 0) return;
      var raw = ((window.innerHeight / 2 - rect.top) / rect.height) * 100;
      var progress = Math.max(0, Math.min(100, raw));
      timeline.style.setProperty('--timeline-progress', progress + '%');
    }
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  })();
</script>

{% schema %}
{
  "name": "Botanique Results",
  "tag": "section",
  "class": "bq-section-results",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 14,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "brand_name_token",   "label": "Brand name (token)",   "default": "Lumière Paris",        "info": "Replaces the literal string %brand% wherever it appears in copy." },
    { "type": "text",     "id": "product_name_token", "label": "Product name (token)", "default": "Il Nostro Dispositivo", "info": "Replaces the literal string %product% wherever it appears in copy." },
    { "type": "richtext", "id": "heading_h2", "label": "Heading (h2)", "default": "<p>I Risultati che Vedrai Usando <br><strong>%product% Ogni Giorno</strong></p>", "info": "Wrap accent words in <strong> for pink emphasis." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url",  "id": "cta_link",  "label": "CTA link" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image (optional, full-bleed)" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "section_padding_top",    "label": "Section padding top",    "min": 0, "max": 200, "step": 5, "default": 60, "unit": "px" },
    { "type": "range", "id": "section_padding_bottom", "label": "Section padding bottom", "min": 0, "max": 200, "step": 5, "default": 60, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Timeline step",
      "limit": 10,
      "settings": [
        { "type": "text",         "id": "time_label",    "label": "Time label", "info": "e.g. \"Settimana 1:\" or \"Mese 3:\"" },
        { "type": "text",         "id": "heading",       "label": "Step heading" },
        { "type": "richtext",     "id": "description",   "label": "Description", "info": "Wrap accent phrases in <strong> for pink emphasis. Use %brand% / %product% tokens for replacements." },
        { "type": "image_picker", "id": "result_image",  "label": "Result image (heading-card thumbnail)" },
        { "type": "image_picker", "id": "desc_icon",     "label": "Description icon" }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    { "name": "Botanique Results", "category": "Botanique" }
  ]
}
{% endschema %}
