{{ 'bq-science-stats.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product_name = section.settings.product_name_token | default: 'Il Nostro Dispositivo'
  assign pad_top = section.settings.section_padding_top | default: 40
  assign pad_bot = section.settings.section_padding_bottom | default: 10
-%}

<section
  class="bq-ss"
  data-section-id="{{ section.id }}"
  style="--bq-ss-pad-top: {{ pad_top }}px; --bq-ss-pad-bot: {{ pad_bot }}px;"
>
  <div class="bq-ss__container">

    <span class="bq-ss__title-wrap" data-aos="fade-down">
      <h3 class="bq-ss__heading"><strong>La scienza</strong> dietro {{ product_name }}</h3>
    </span>

    <span class="bq-ss__subtitle-wrap" data-aos="fade-down">
      <p class="bq-ss__subtitle">Risultati riportati da studi clinici e dall'esperienza dei clienti:</p>
    </span>

    <div class="bq-ss__grid">

      <div class="bq-ss__box" data-aos="fade-up">
        <h3 class="bq-ss__number">91%</h3>
        <h4 class="bq-ss__headline">Riduzione del gonfiore sottooculare</h4>
        <p class="bq-ss__mechanism">La microcorrente attiva il drenaggio linfatico per eliminare i liquidi in eccesso.</p>
      </div>

      <div class="bq-ss__box" data-aos="fade-up">
        <h3 class="bq-ss__number">87%</h3>
        <h4 class="bq-ss__headline">Occhiaie più luminose e meno infossate</h4>
        <p class="bq-ss__mechanism">La luce rossa aumenta la circolazione, eliminando il sangue ristagante che crea le ombre scure.</p>
      </div>

      <div class="bq-ss__box" data-aos="fade-up">
        <h3 class="bq-ss__number">35%</h3>
        <h4 class="bq-ss__headline">Aumento della densità del collagene</h4>
        <p class="bq-ss__mechanism">La luce rossa stimola la produzione di collagene, ispessendo la pelle per attenuare rughe e cavità.</p>
      </div>

      <div class="bq-ss__box" data-aos="fade-up">
        <h3 class="bq-ss__number">94%</h3>
        <h4 class="bq-ss__headline">Pelle più liscia e tonica</h4>
        <p class="bq-ss__mechanism">La doppia tecnologia combina collagene e tono muscolare per un lifting visibile.</p>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "BQ Science Stats",
  "tag": "div",
  "class": "bq-science-stats-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "product_name_token",
      "label": "Nome prodotto",
      "default": "Il Nostro Dispositivo"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "BQ Science Stats"
    }
  ]
}
{% endschema %}
