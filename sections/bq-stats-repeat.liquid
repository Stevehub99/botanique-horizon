{
  "name": "BQ Stats Repeat",
  "tag": "div",
  "class": "bq-stats-repeat-wrapper",
  "settings": [],
  "presets": [
    {
      "name": "BQ Stats Repeat"
    }
  ]
}
{% endschema %}
